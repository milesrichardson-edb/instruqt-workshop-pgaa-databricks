#!/bin/bash
# Verify the CTAS landed in the local Lakekeeper warehouse.
# psql is inside the pgd container, not on the host VM — exec into it.
set -euo pipefail

run_sql() {
  docker exec pgd bash -c "PGPASSWORD=secret psql -U postgres -d demo -tAc \"$1\""
}

# Table exists?
EXISTS=$(run_sql "SELECT to_regclass('test_schema.region') IS NOT NULL")
if [ "$EXISTS" != "t" ]; then
  echo "FAIL: test_schema.region doesn't exist yet." >&2
  echo "      Paste the local CTAS block from the assignment into the Lab DB tab." >&2
  exit 1
fi

# Row count matches the seed (5 regions)?
COUNT=$(run_sql "SELECT count(*) FROM test_schema.region")
if [ "$COUNT" != "5" ]; then
  echo "FAIL: test_schema.region has $COUNT rows (expected 5)." >&2
  exit 1
fi

# Listed in pgaa.list_analytics_tables under our catalog?
CATALOG=$(run_sql "SELECT catalog_name FROM pgaa.list_analytics_tables() WHERE schema_name='test_schema' AND table_name='region'")
if [ "$CATALOG" != "local_lakekeeper" ]; then
  echo "FAIL: test_schema.region is not managed by local_lakekeeper (saw '$CATALOG')." >&2
  exit 1
fi

echo "OK: test_schema.region exists, 5 rows, managed by local_lakekeeper."
exit 0
