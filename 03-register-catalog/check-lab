#!/bin/bash
# Confirm the local Lakekeeper catalog is registered and attached.
set -euo pipefail

PSQL="PGPASSWORD=secret psql -h localhost -p 7432 -U postgres -d demo -tAc"

if ! eval "$PSQL \"SELECT 1\"" >/dev/null 2>&1; then
  echo "Couldn't connect to PGD on :7432." >&2
  exit 1
fi

ROW=$(eval "$PSQL \"SELECT name||'|'||status FROM pgaa.list_catalogs() WHERE name = 'local_lakekeeper'\"")

if [ -z "$ROW" ]; then
  echo "FAIL: pgaa.list_catalogs() does not include 'local_lakekeeper'." >&2
  echo "      Re-run the local block in the assignment." >&2
  exit 1
fi

STATUS="${ROW##*|}"
if [ "$STATUS" != "attached" ]; then
  echo "FAIL: local_lakekeeper is registered but status='$STATUS' (expected 'attached')." >&2
  echo "      Check the Lakekeeper container is healthy: docker compose ps" >&2
  exit 1
fi

echo "OK: local_lakekeeper registered and attached."
exit 0
