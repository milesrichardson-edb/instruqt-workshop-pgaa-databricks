#!/bin/bash
# Top-level lab setup — runs once when the sandbox VM boots, before challenge 01.
#
# Instruqt only ships the track files (track.yml, config.yml, challenge dirs,
# track_scripts/) onto the sandbox VM — it does NOT auto-upload arbitrary
# directories like lab/. So we git-clone the public workshop repo at boot and
# run docker compose against the cloned lab/.
#
# Brings up the local PGD + PGAA + Lakekeeper + Spark + MinIO stack so every
# implementation challenge has a "local backend" to demonstrate against, in
# parallel with the learner's real Postgres host → Databricks UC steps.
#
# Idempotent: safe to re-run. Per-challenge setup-host scripts only sanity-
# check the relevant service; they do not re-invoke `docker compose up`.

set -euo pipefail

# Public Git repo that holds this workshop. Override with WORKSHOP_REPO_URL /
# WORKSHOP_REPO_REF in the Instruqt UI if you forked.
REPO_URL="${WORKSHOP_REPO_URL:-https://github.com/milesrichardson-edb/instruqt-workshop-pgaa-databricks.git}"
REPO_REF="${WORKSHOP_REPO_REF:-main}"

WORK_DIR="/root/workshop"
LAB_DIR="$WORK_DIR/lab"
COMPOSE="docker compose"
NET="converged-analytics-network"

log() { echo "[setup-lab] $*"; }

# 1. Fetch the workshop repo (lab/ + everything else). Idempotent: if the
#    clone already exists, fast-forward instead.
if [ ! -d "$WORK_DIR/.git" ]; then
  log "Cloning $REPO_URL ($REPO_REF) → $WORK_DIR"
  git clone --depth 1 --branch "$REPO_REF" "$REPO_URL" "$WORK_DIR"
else
  log "Updating existing clone at $WORK_DIR"
  git -C "$WORK_DIR" fetch --depth 1 origin "$REPO_REF"
  git -C "$WORK_DIR" reset --hard "origin/$REPO_REF"
fi

if [ ! -d "$LAB_DIR" ]; then
  log "ERROR: $LAB_DIR not found after clone — check WORKSHOP_REPO_URL."
  exit 1
fi

cd "$LAB_DIR"

# 2. Network. The component compose files declare this network as
#    `external: true`, so create it ourselves before bringing the stack up.
if ! docker network inspect "$NET" >/dev/null 2>&1; then
  log "Creating docker network: $NET"
  docker network create "$NET"
fi

# 3. EDB token. Instruqt injects sandbox secrets as env vars on the lab VM.
#    The PGD Dockerfile expects EDB_SUBSCRIPTION_TOKEN as a BuildKit secret,
#    fed from this env var (see lab/components/transactional-db/docker-compose.yml's
#    `secrets:` stanza).
if [ -z "${EDB_SUBSCRIPTION_TOKEN:-}" ]; then
  log "ERROR: EDB_SUBSCRIPTION_TOKEN is not set."
  log "  Set it under Org → Settings → Secrets in the Instruqt UI; the"
  log "  PGD image build needs it to install edb-pgd6-* and edb-postgresextended-17-pgaa."
  log "  Continuing — but the PGD service will fail to build."
fi
export EDB_SUBSCRIPTION_TOKEN

# 4. Pre-pull the images that don't need to be built — Lakekeeper, MinIO,
#    Spark, Postgres for Lakekeeper. Saves time during the first compose-up.
log "Pulling buildless images..."
$COMPOSE pull --ignore-buildable 2>&1 | sed 's/^/[setup-lab]   /' || true

# 5. Build PGD with the BuildKit secret. We do this explicitly (rather than
#    letting `compose up` build implicitly) so failures surface as a clear
#    build-stage error rather than a confusing service start error.
log "Building PGD image (this is the slow step — ~3-5 min on first boot)..."
DOCKER_BUILDKIT=1 $COMPOSE build pgd 2>&1 | sed 's/^/[setup-lab]   /'

# 6. Bring everyone up.
log "Starting lab stack..."
$COMPOSE up -d

# 7. Wait for the services that the next-challenge check-lab scripts need.
log "Waiting for Lakekeeper to be healthy..."
for i in $(seq 1 60); do
  if curl -sf http://localhost:8181/health >/dev/null 2>&1; then
    log "Lakekeeper ready."
    break
  fi
  sleep 2
done

log "Waiting for PGD to accept connections (via container)..."
# psql isn't on the sandbox VM, so we exec into the PGD container. PGD's own
# healthcheck runs the same command, so once `docker exec` succeeds we know
# both the container is up and the demo DB exists.
for i in $(seq 1 90); do
  if docker exec pgd bash -c "PGPASSWORD=secret psql -U postgres -d demo -c 'SELECT 1'" >/dev/null 2>&1; then
    log "PGD ready (after ${i} attempts)."
    break
  fi
  sleep 2
done

log "Applying source-schema seed (region + lineitem)..."
# Stream the seed file into psql inside the container; no need to bind-mount.
docker exec -i pgd bash -c "PGPASSWORD=secret psql -U postgres -d demo -v ON_ERROR_STOP=1" \
  < "$LAB_DIR/seed/010_source_schema.sql" 2>&1 | sed 's/^/[setup-lab]   /' \
  || log "Seed already applied (or PGD unavailable)"

# The PGD entrypoint registers `local_lakekeeper` via `bdr.replicate_ddl_command`,
# which leaves the catalog detached on a single-node lab. Drop the BDR-replicated
# row and re-add directly so the catalog ends up attached and queryable.
# Idempotent: re-running `delete_catalog` for a missing catalog is a no-op via
# the cascade flag.
log "Re-registering local_lakekeeper catalog directly (bypassing BDR replication)..."
WAREHOUSE_ID=$(curl -fsS http://localhost:8181/management/v1/warehouse 2>/dev/null \
  | python3 -c "import sys, json; data=json.load(sys.stdin); print(next((w['id'] for w in data.get('warehouses', []) if w.get('name') == 'demo-warehouse'), ''))" 2>/dev/null \
  || echo "")
if [ -z "$WAREHOUSE_ID" ]; then
  log "WARNING: Could not look up demo-warehouse ID from Lakekeeper. Catalog reg may fail."
fi

docker exec -i pgd bash -c "PGPASSWORD=secret psql -U postgres -d demo -v ON_ERROR_STOP=0" 2>&1 \
  | sed 's/^/[setup-lab]   /' <<EOSQL || log "(catalog re-register reported errors — challenge 03 will diagnose)"
SELECT * FROM pgaa.delete_catalog('local_lakekeeper', cascade := true);
SELECT pgaa.add_catalog(
  'local_lakekeeper',
  'iceberg-rest',
  '{
    "url": "http://lakekeeper:8181/catalog",
    "warehouse": "$WAREHOUSE_ID",
    "warehouse_name": "demo-warehouse"
  }'
);
SELECT name, type, status FROM pgaa.list_catalogs() WHERE name = 'local_lakekeeper';
EOSQL

log "Lab setup complete."
