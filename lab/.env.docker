# Wired into the PGD container via docker-compose `env_file`. Mirrors the
# CATALOG_* values from .env so docker-entrypoint.sh can register the local
# Lakekeeper catalog at first boot.

# PGD
PGD_HOST=pgd
PGD_PORT=5432
PGD_USER=postgres
PGD_PASSWORD=secret
PGD_DATABASE=demo
PGD_SSLMODE=prefer
PGD_SPARK_CONNECT_URL=sc://spark-connect:15002

# CATALOG (local Lakekeeper — NOT a real Databricks UC)
CATALOG_NAME=local_lakekeeper
CATALOG_TYPE=iceberg-rest
CATALOG_URL=http://lakekeeper:8181/catalog
CATALOG_WAREHOUSE=demo-warehouse
CATALOG_WAREHOUSE_NAME=demo-warehouse
CATALOG_TOKEN=
CATALOG_DANGER_ACCEPT_INVALID_CERTS=true

# OBJECT_STORE
OBJECT_STORE_TYPE=minio
OBJECT_STORE_ENDPOINT=http://minio:9000
OBJECT_STORE_BUCKET=warehouse
OBJECT_STORE_ACCESS_KEY=minioadmin
OBJECT_STORE_SECRET_KEY=minioadmin
OBJECT_STORE_REGION=us-east-1
OBJECT_STORE_PATH_STYLE_ACCESS=true
