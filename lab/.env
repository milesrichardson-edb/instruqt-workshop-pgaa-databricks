# Local lab environment — used by the vendored docker-compose files.
# This file does NOT contain real Databricks credentials; those live on
# the learner's own Postgres host. The vars below configure the LOCAL
# Lakekeeper catalog so the workshop's "Instruqt sandbox" copy-paste blocks
# have a real backend to talk to.

# Catalog (Lakekeeper, local Iceberg REST)
CATALOG_NAME=local_lakekeeper
CATALOG_TYPE=iceberg-rest
CATALOG_URL=http://lakekeeper:8181/catalog
CATALOG_WAREHOUSE=demo-warehouse
CATALOG_WAREHOUSE_NAME=demo-warehouse

# Object storage (MinIO)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# PGD password
POSTGRES_PASSWORD=secret

# Spark worker sizing — kept modest so the n1-standard-4 sandbox VM doesn't OOM.
SPARK_WORKER_MEMORY=4g
SPARK_WORKER_CORES=2

