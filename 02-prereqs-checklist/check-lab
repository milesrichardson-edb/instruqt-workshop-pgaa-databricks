#!/bin/bash
# Confirm the local lab is up — the next challenge will exercise it.
set -euo pipefail

if ! curl -fsS http://localhost:8181/health >/dev/null 2>&1; then
  echo "Lakekeeper isn't responding on :8181 yet. Wait ~15s and click Check again." >&2
  exit 1
fi

# psql is inside the pgd container, not on the host VM — exec into it.
if ! docker exec pgd bash -c "PGPASSWORD=secret psql -U postgres -d demo -c 'SELECT 1'" >/dev/null 2>&1; then
  echo "PGD isn't ready yet. Wait ~15s and click Check again." >&2
  exit 1
fi

exit 0
